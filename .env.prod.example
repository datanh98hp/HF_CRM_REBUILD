NODE_ENV=production
API_PORT=3002
WEB_PORT=3100
WEB_DOMAIN=crm.example.com
API_DOMAIN=api.crm.example.com
WEB_ORIGINS=https://crm.example.com
NEXT_PUBLIC_API_BASE_URL=https://api.crm.example.com
POSTGRES_DB=finance_crm_prod
POSTGRES_USER=finance_crm_prod
POSTGRES_PASSWORD=SET_IN_SECRET_MANAGER
AUTH_ACCESS_TOKEN_SECRET=SET_IN_SECRET_MANAGER
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
WORKER_CONCURRENCY=5
API_REPLICAS=2
WORKER_REPLICAS=2
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_DISPLAY_NAME=
BOOTSTRAP_ADMIN_PASSWORD=SET_IN_SECRET_MANAGER

# Configure a private MinIO bucket and credentials via the secret manager before enabling file handling.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_REGION=us-east-1
MINIO_PREFIX=contracts
BACKUP_ENCRYPTION_KEY=SET_IN_SECRET_MANAGER

# Deferred integration slots. Keep unset until adapters are implemented and provider details are approved.
# CUSTOMER_AUTH_PROVIDER=
# CUSTOMER_AUTH_ISSUER=
# SMS_GATEWAY_URL=
# SMS_GATEWAY_TOKEN=
