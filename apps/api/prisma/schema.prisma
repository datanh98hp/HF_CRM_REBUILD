generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AccessScope {
  OWN
  ASSIGNED
  BRANCH
  ALL
}

enum CustomerStatus {
  NEW
  CONTACTED
  QUALIFIED
  IN_PROGRESS
  CONVERTED
  CLOSED
}

enum CustomerVerificationStatus {
  UNVERIFIED
  VERIFIED
}

enum DuplicateReviewStatus {
  OPEN
  CONFIRMED_DUPLICATE
  NOT_DUPLICATE
}

enum LoanRequestSource {
  CUSTOMER
  ADVISING
}

enum LoanRequestStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum LoanContractStatus {
  PENDING_REVIEW
  APPROVED
  AWAITING_CUSTOMER_CONFIRMATION
  COMPLETED
  REJECTED
  CANCELLED
}

enum PlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ContractOtpChallengeStatus {
  PENDING
  VERIFIED
  INVALIDATED
  LOCKED
}

model Branch {
  id        String       @id @default(uuid()) @db.Uuid
  code      String       @unique @db.VarChar(64)
  name      String       @db.VarChar(160)
  parentId  String?      @db.Uuid
  managerUserId String?  @db.Uuid
  status    BranchStatus @default(INACTIVE)
  parent    Branch?      @relation("BranchHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  manager   User?        @relation("BranchManager", fields: [managerUserId], references: [id], onDelete: Restrict)
  children  Branch[]     @relation("BranchHierarchy")
  grants    UserRoleGrant[]
  auditEvents AuditEvent[]
  customers Customer[]
  customerAssignments CustomerAssignment[]
  loanRequests LoanRequest[]
  loanContracts LoanContract[]
  planBranches PlanBranch[]
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  @@index([parentId, status])
  @@index([name])
}

model User {
  id                 String          @id @default(uuid()) @db.Uuid
  username           String          @unique @db.VarChar(120)
  displayName        String          @db.VarChar(160)
  passwordHash       String          @db.VarChar(255)
  status             UserStatus      @default(ACTIVE)
  mustChangePassword Boolean         @default(false)
  failedLoginCount   Int             @default(0)
  lockedUntil        DateTime?       @db.Timestamptz(3)
  passwordChangedAt  DateTime        @default(now()) @db.Timestamptz(3)
  roleGrants         UserRoleGrant[]
  sessions           AuthSession[]
  managedBranches    Branch[]        @relation("BranchManager")
  grantsCreated      UserRoleGrant[] @relation("GrantCreator")
  auditEvents        AuditEvent[]    @relation("AuditActor")
  createdCustomers   Customer[]      @relation("CustomerCreator")
  customerAssignments CustomerAssignment[] @relation("CustomerAdviser")
  assignmentsCreated CustomerAssignment[] @relation("CustomerAssignmentCreator")
  customerStatusChanges CustomerStatusHistory[] @relation("CustomerStatusActor")
  duplicateReviews DuplicateCandidate[] @relation("DuplicateReviewer")
  recordedLoanRequests LoanRequest[] @relation("LoanRequestRecorder")
  createdLoanContracts LoanContract[] @relation("LoanContractCreator")
  approvedLoanContracts LoanContract[] @relation("LoanContractApprover")
  loanContractStatusChanges LoanContractStatusHistory[] @relation("LoanContractStatusActor")
  createdPlans Plan[] @relation("PlanCreator")
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)

  @@index([status, username])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(80)
  name        String           @db.VarChar(120)
  description String?          @db.VarChar(500)
  isSystem    Boolean          @default(false)
  permissions RolePermission[]
  userGrants  UserRoleGrant[]
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  @@index([isSystem, key])
}

model Permission {
  key         String           @id @db.VarChar(120)
  groupKey    String           @db.VarChar(80)
  description String           @db.VarChar(300)
  roleGrants  RolePermission[]
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)

  @@index([groupKey, key])
}

model RolePermission {
  roleId       String      @db.Uuid
  permissionKey String     @db.VarChar(120)
  scope        AccessScope
  role         Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@id([roleId, permissionKey, scope])
  @@index([permissionKey, scope])
}

model UserRoleGrant {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  roleId      String   @db.Uuid
  branchId    String?  @db.Uuid
  scopeAnchor String   @default("GLOBAL") @db.VarChar(40)
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy   User?    @relation("GrantCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([userId, roleId, scopeAnchor])
  @@index([userId, roleId])
  @@index([branchId, roleId])
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique @db.Char(64)
  expiresAt        DateTime  @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  replacedById     String?   @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt       DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, revokedAt, expiresAt])
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String?  @db.Uuid
  action      String   @db.VarChar(120)
  targetType  String   @db.VarChar(80)
  targetId    String?  @db.VarChar(120)
  branchId    String?  @db.Uuid
  reason      String?  @db.VarChar(1000)
  beforeState Json?
  afterState  Json?
  requestId   String?  @db.VarChar(128)
  actor       User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([actorId, createdAt])
  @@index([branchId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([action, createdAt])
}

model Customer {
  id                 String                     @id @default(uuid()) @db.Uuid
  fullName           String                     @db.VarChar(160)
  normalizedName     String                     @db.VarChar(160)
  dateOfBirth        DateTime?                  @db.Date
  phone              String                     @db.VarChar(32)
  phoneNormalized    String                     @db.VarChar(24)
  email              String?                    @db.VarChar(254)
  emailNormalized    String?                    @db.VarChar(254)
  provenance         String                     @db.VarChar(120)
  verificationStatus CustomerVerificationStatus @default(UNVERIFIED)
  phoneVerifiedAt   DateTime?                  @db.Timestamptz(3)
  status             CustomerStatus             @default(NEW)
  branchId           String                     @db.Uuid
  createdById        String?                    @db.Uuid
  branch             Branch                     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy          User?                      @relation("CustomerCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignments        CustomerAssignment[]
  statusHistory      CustomerStatusHistory[]
  initiatedStatusChanges CustomerStatusHistory[] @relation("CustomerStatusCustomerActor")
  loanRequests       LoanRequest[]
  contracts          LoanContract[]
  contractOtpChallenges ContractOtpChallenge[]
  initiatedContractStatusChanges LoanContractStatusHistory[] @relation("LoanContractCustomerStatusActor")
  duplicateCandidates DuplicateCandidate[]      @relation("DuplicateSource")
  duplicateMatches   DuplicateCandidate[]       @relation("DuplicateMatch")
  createdAt          DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                   @updatedAt @db.Timestamptz(3)

  @@index([branchId, status, createdAt])
  @@index([phoneNormalized])
  @@index([emailNormalized])
  @@index([normalizedName, dateOfBirth])
}

model CustomerAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  customerId   String    @db.Uuid
  adviserId    String    @db.Uuid
  branchId     String    @db.Uuid
  assignedById String?   @db.Uuid
  isPrimary    Boolean   @default(true)
  assignedAt   DateTime  @default(now()) @db.Timestamptz(3)
  endedAt      DateTime? @db.Timestamptz(3)
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  adviser      User      @relation("CustomerAdviser", fields: [adviserId], references: [id], onDelete: Restrict)
  branch       Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  assignedBy   User?     @relation("CustomerAssignmentCreator", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([customerId, endedAt])
  @@index([adviserId, endedAt])
  @@index([branchId, endedAt])
}

model CustomerStatusHistory {
  id          String         @id @default(uuid()) @db.Uuid
  customerId  String         @db.Uuid
  fromStatus  CustomerStatus
  toStatus    CustomerStatus
  reason      String         @db.VarChar(1000)
  changedById String?        @db.Uuid
  changedByCustomerId String? @db.Uuid
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  customer    Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  changedBy   User?          @relation("CustomerStatusActor", fields: [changedById], references: [id], onDelete: SetNull)
  changedByCustomer Customer? @relation("CustomerStatusCustomerActor", fields: [changedByCustomerId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
}

model DuplicateCandidate {
  id                  String                @id @default(uuid()) @db.Uuid
  customerId          String                @db.Uuid
  candidateCustomerId String                @db.Uuid
  matchReasons        Json
  isCurrent           Boolean               @default(true)
  status              DuplicateReviewStatus @default(OPEN)
  reviewedById        String?               @db.Uuid
  reviewedAt          DateTime?             @db.Timestamptz(3)
  resolutionReason    String?               @db.VarChar(1000)
  customer            Customer              @relation("DuplicateSource", fields: [customerId], references: [id], onDelete: Restrict)
  candidateCustomer   Customer              @relation("DuplicateMatch", fields: [candidateCustomerId], references: [id], onDelete: Restrict)
  reviewedBy          User?                 @relation("DuplicateReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt           DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @db.Timestamptz(3)

  @@unique([customerId, candidateCustomerId])
  @@index([customerId, status])
  @@index([candidateCustomerId, status])
}

model LoanRequest {
  id           String            @id @default(uuid()) @db.Uuid
  customerId   String            @db.Uuid
  branchId     String            @db.Uuid
  source       LoanRequestSource
  topic        String            @db.VarChar(200)
  notes        String?           @db.VarChar(4000)
  status       LoanRequestStatus @default(OPEN)
  recordedById String?           @db.Uuid
  customer     Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branch       Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  recordedBy   User?             @relation("LoanRequestRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)

  @@index([customerId, createdAt])
  @@index([branchId, status, createdAt])
}

model LoanContract {
  id                 String                      @id @default(uuid()) @db.Uuid
  customerId         String                      @db.Uuid
  branchId           String                      @db.Uuid
  contractNumber     String                      @unique @db.VarChar(120)
  packageCode        String?                     @db.VarChar(80)
  packageName        String                      @db.VarChar(200)
  packageVersion     String?                     @db.VarChar(40)
  loanType           String?                     @db.VarChar(120)
  termMonths         Int?
  sourceSystem       String?                     @db.VarChar(80)
  externalContractId String?                     @db.VarChar(160)
  sourceUpdatedAt    DateTime?                   @db.Timestamptz(3)
  receivedAt         DateTime                    @default(now()) @db.Timestamptz(3)
  importBatchId      String?                     @db.VarChar(120)
  sourcePayloadHash  String?                     @db.Char(64)
  idempotencyKeyHash String?                     @unique @db.Char(64)
  status             LoanContractStatus          @default(PENDING_REVIEW)
  version            Int                         @default(1)
  approvedById       String?                     @db.Uuid
  approvedAt         DateTime?                   @db.Timestamptz(3)
  completedAt        DateTime?                   @db.Timestamptz(3)
  createdById        String?                     @db.Uuid
  customer           Customer                    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branch             Branch                      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy          User?                       @relation("LoanContractCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy         User?                       @relation("LoanContractApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  statusHistory      LoanContractStatusHistory[]
  otpChallenges      ContractOtpChallenge[]
  createdAt          DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                    @updatedAt @db.Timestamptz(3)

  @@unique([sourceSystem, externalContractId])
  @@index([customerId, createdAt])
  @@index([branchId, status, createdAt])
  @@index([sourceSystem, receivedAt])
}

model LoanContractStatusHistory {
  id          String             @id @default(uuid()) @db.Uuid
  contractId  String             @db.Uuid
  fromStatus  LoanContractStatus?
  toStatus    LoanContractStatus
  reason      String             @db.VarChar(1000)
  changedById String?            @db.Uuid
  changedByCustomerId String?    @db.Uuid
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  contract    LoanContract       @relation(fields: [contractId], references: [id], onDelete: Restrict)
  changedBy   User?              @relation("LoanContractStatusActor", fields: [changedById], references: [id], onDelete: SetNull)
  changedByCustomer Customer?    @relation("LoanContractCustomerStatusActor", fields: [changedByCustomerId], references: [id], onDelete: SetNull)

  @@index([contractId, createdAt])
}

model ContractOtpChallenge {
  id              String                     @id @default(uuid()) @db.Uuid
  contractId      String                     @db.Uuid
  customerId      String                     @db.Uuid
  codeHash        String                     @db.Char(64)
  contractVersion Int
  contentHash     String                     @db.Char(64)
  status          ContractOtpChallengeStatus @default(PENDING)
  attempts        Int                        @default(0)
  expiresAt       DateTime                   @db.Timestamptz(3)
  lastSentAt      DateTime                   @default(now()) @db.Timestamptz(3)
  verifiedAt      DateTime?                  @db.Timestamptz(3)
  createdAt       DateTime                   @default(now()) @db.Timestamptz(3)
  contract        LoanContract               @relation(fields: [contractId], references: [id], onDelete: Restrict)
  customer        Customer                   @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([contractId, status, createdAt])
  @@index([customerId, createdAt])
}

model Plan {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(160)
  description String?      @db.VarChar(1000)
  createdById String       @db.Uuid
  periodStart DateTime     @db.Timestamptz(3)
  periodEnd   DateTime     @db.Timestamptz(3)
  status      PlanStatus   @default(DRAFT)
  deletedAt   DateTime?    @db.Timestamptz(3)
  createdBy   User          @relation("PlanCreator", fields: [createdById], references: [id], onDelete: Restrict)
  branches    PlanBranch[]
  metrics     PlanMetric[]
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  @@index([periodStart, periodEnd, deletedAt])
  @@index([createdById, createdAt])
}

model PlanBranch {
  planId   String   @db.Uuid
  branchId String   @db.Uuid
  plan     Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([planId, branchId])
  @@index([branchId, planId])
}

model PlanMetric {
  id        String   @id @default(uuid()) @db.Uuid
  planId    String   @db.Uuid
  name      String   @db.VarChar(160)
  unit      String   @db.VarChar(40)
  target    Decimal  @db.Decimal(16, 3)
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([planId, name])
  @@index([planId])
}
